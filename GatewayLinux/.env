# GATEWAY RHM Linux — copier en .env et remplir
# MQTT
MQTT_HOST=51.83.40.138
MQTT_PORT=1883
MQTT_USER=tvclient
MQTT_PASS=tvclient210367@Tunis
MQTT_PREFIX=eis/colmi
GATEWAY_TYPE=linux
RING_MAC=30:32:42:32:64:01
RING_NAME=R10_6401
GATEWAY_NAME=GW-Linux-RHM_PI_400
COLMI_CLI=/root/.local/bin/colmi_r02_client
# Statut toutes les 60 s ; contrôle de la bague (« info ») toutes les 5 min (0 = jamais)
STATUS_SECONDS=60
RING_CHECK_SECONDS=300
CMD_TIMEOUT=90
# Sédentarité (à partir des pas) : journée et seuil de pas par tranche de 15 min
SEDENTARY_START_HOUR=8
SEDENTARY_END_HOUR=21
SEDENTARY_STEPS_PER_SLOT=30
####chaque boîtier
####ROAMING=race
####ROAMING=0
ROAMING=0
REACH_SCRIPT=/root/GatewayLinux/test_reachable_v1.py
MEASURE_SCRIPT=/root/colmi_wiss/colmi_4_mesures_v3_clean.py
# Bouton Température : script à part (température seule)
TEMP_SCRIPT=/root/GatewayLinux/colmi_temperature.py
REACH_PYTHON=/usr/local/bin/python3.14
REACH_WINDOW=5
REACH_JSON=1          # 1 = affiche aussi la ligne RESULT_JSON

# ---- Gateway RHM v3.2 : script 4 mesures + multi-bagues (zones)
MEASURE_SCRIPT_CMDS=all
#####MEASURE_SCRIPT_CMDS=hr,spo2,temp,all
# Temps max. du script 4 mesures (≈ 2 min, jusqu'à ~3 min)
MEASURE_SCRIPT_TIMEOUT=240
# Écoute passive : fenêtre (s) et pause entre deux fenêtres (s)
SCAN_WINDOW=4
SCAN_PAUSE=1
# Verrou Bluetooth partagé + bagues entendues + mesure en cours
GATEWAY_RUN_DIR=/run/gateway-rhm
# « À portée » si la bague a été entendue il y a moins de N s (écoute passive)
REACH_SEEN_FRESH_SECONDS=20

# Écoute passive (scan_rings.py) désactivée : portée = test_reachable_v1.py
PASSIVE_SCAN=0
BT_RESTART_BEFORE_MEASURE=0

# Mesure : 3 essais sur la Pi de la mesure, Bluetooth redémarré avant le 3e
BLE_RETRIES=3
BT_RESET_AFTER=2
