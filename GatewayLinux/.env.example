# GATEWAY RHM Linux — copier en .env et remplir
MQTT_HOST=www.itigroups.biz
MQTT_PORT=1883
MQTT_USER=colmi
MQTT_PASS=***
MQTT_PREFIX=eis/colmi
# Multi-bagues (gateway_multi.py) : les bagues viennent des ZONES de l'admin.
# RING_MAC ne sert que tant qu'aucune zone n'est choisie pour cette gateway (ou en ancien mode).
RING_MAC=30:32:42:32:64:01
RING_NAME=R10_6401
GATEWAY_NAME=GW-Linux-RHM
# Type annoncé au serveur : linux (hors portée → Actualiser/mesures quand même autorisés)
GATEWAY_TYPE=linux
COLMI_CLI=/root/.local/bin/colmi_r02_client
# Statut toutes les 60 s (Gateway en ligne + bague associée) ; contrôle BLE périodique « info » : 0 = jamais
# (la bague est vérifiée par « Actualiser » = mesure heart-rate depuis le Client RHM)
STATUS_SECONDS=60
RING_CHECK_SECONDS=0
CMD_TIMEOUT=90
# Sédentarité (à partir des pas) : journée et seuil de pas par tranche de 15 min
SEDENTARY_START_HOUR=8
SEDENTARY_END_HOUR=21
SEDENTARY_STEPS_PER_SLOT=30
# Boutons de l'admin : redémarrer le Bluetooth / le service / la machine (0 = refusé)
ALLOW_REMOTE_BT_RESTART=1
ALLOW_REMOTE_RESTART=1
# Service relancé par le bouton « Service » (systemctl restart <nom>)
SERVICE_NAME=gateway-rhm
ALLOW_REMOTE_REBOOT=1
# IP publique envoyée à l'admin
WAN_IP_URL=https://api.ipify.org
# Test de portée (« Actualiser ») : script de Wissem, lancé à tour de rôle par le serveur
REACH_SCRIPT=/root/colmi_wiss/test_reachable_v1.py
REACH_PYTHON=/usr/bin/python3.14
REACH_WINDOW=5
# test_reachable_v1.py lancé à la main : 1 = affiche aussi la ligne RESULT_JSON
REACH_JSON=0
# Mesures HR / SpO2 / T° / all : script de Wissem, une connexion HR → SpO2 → température → HRV
# (ancien script possible : MEASURE_SCRIPT=/root/colmi_wiss/wiss_test_04_fast_one_connection.py et MEASURE_SCRIPT_CMDS=hr,spo2,all)
MEASURE_SCRIPT=/root/colmi_wiss/colmi_4_mesures_v3_clean.py
MEASURE_SCRIPT_CMDS=hr,spo2,temp,all
# Bluetooth : systemctl restart bluetooth après chaque mesure réussie et à l'arrêt (0 = jamais) ;
# après un échec seulement si aucun appareil n'est entendu, au plus une fois par intervalle (s)
BT_RESTART_AFTER_SUCCESS=1
BT_RESTART_ON_FAIL_MIN_INTERVAL=600
# Multi-bagues : écoute passive en continu (Python avec bleak)
# SCAN_PYTHON=python3.14   (facultatif : par défaut python3.14)
# Fenêtre d'écoute (s) et pause entre deux fenêtres ; une mesure interrompt l'écoute tout de suite
SCAN_WINDOW=4
SCAN_PAUSE=1
