# =====================================================================
# QRing Admin + Bot Telegram — fichier .env (un seul pour les deux)
# Copier en .env à côté de app.py et telegram_bot.py, puis remplir.
# Les valeurs indiquées sont les valeurs par défaut.
# =====================================================================

# ---------- Broker MQTT (Mosquitto) ----------
MQTT_HOST=51.83.40.138
MQTT_PORT=1883
MQTT_USER=tvclient
MQTT_PASSWORD=
# Préfixe des topics (QRing Admin) et abonnement (bot)
MQTT_PREFIX=eis/colmi
MQTT_TOPIC=eis/colmi/#

# ---------- PostgreSQL (base smart_ring) ----------
DB_ENABLED=1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smart_ring
DB_USER=iti
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5

# ---------- QRing Admin (Flask) ----------
QRING_ADMIN_PASSWORD=
QRING_SECRET_KEY=
QRING_ADMIN_PORT=5055
# Secondes sans statut d'une TV avant « hors ligne » (admin + bot)
QRING_OFFLINE_AFTER=150

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# Admins du bot (IDs séparés par des virgules) : appariements QR + toutes les alertes
TELEGRAM_ADMIN_IDS=
# 1 = le bot ne répond qu'en conversation privée
TELEGRAM_PRIVATE_ONLY=1
TELEGRAM_LOG_LEVEL=INFO
# Droit « Alertes » accordé automatiquement lors d'un appariement QR approuvé
PAIRING_DEFAULT_ALERTS=0

# ---------- Web App (Mini App Telegram, servie par QRing Admin) ----------
# Adresse HTTPS publique qui mène à QRing Admin (bouton 🌐 Web App)
TELEGRAM_WEBAPP_BASE_URL=
# Session Web App « active » si activité plus récente que ce délai
TELEGRAM_WEBAPP_ACTIVE_SECONDS=60
# Validité de la signature Telegram à l'ouverture de la Web App
TELEGRAM_WEBAPP_MAX_AGE_SECONDS=86400

# ---------- Check « État / Status » (bot + Web App) ----------
# Mesure sans problème pendant ce délai => bague portée
TELEGRAM_WEAR_CHECK_SECONDS=15
# Un port vérifié est réutilisé pendant ce délai (économise la batterie)
TELEGRAM_WEAR_REUSE_SECONDS=120
# Écran d'une bague mis à jour tout seul pendant ce délai
TELEGRAM_RING_WATCH_MINUTES=30

# ---------- Alertes Telegram ----------
TELEGRAM_ALERTS_ENABLED=1
# Hors portée / TV hors ligne confirmés après ce délai (anti-coupures brèves)
TELEGRAM_ALERT_CONFIRM_SECONDS=60
# Seuil de batterie faible (%)
TELEGRAM_ALERT_BATTERY_LOW=20

# ---------- App téléphone QRingClient (service client_api.py, indépendant de QRing Admin) ----------
CLIENT_API_PORT=5060
# Clé qui signe les connexions de l'app (longue chaîne aléatoire). Si elle change, les téléphones se reconnectent.
CLIENT_API_SECRET=
# Durée de connexion du téléphone (« rester connecté »), en jours
CLIENT_TOKEN_DAYS=30
# Hors portée / TV hors ligne confirmés après ce délai avant l'alerte (défaut : TELEGRAM_ALERT_CONFIRM_SECONDS)
CLIENT_ALERT_CONFIRM_SECONDS=60
# Seuil de batterie faible (%) (défaut : TELEGRAM_ALERT_BATTERY_LOW)
CLIENT_ALERT_BATTERY_LOW=20
# HTTPS : certificat + clé (ex. Let's Encrypt de www.itigroups.biz). Vide = HTTP (à mettre derrière Nginx en HTTPS)
CLIENT_API_SSL_CERT=
CLIENT_API_SSL_KEY=
# Clé de service Firebase (fichier JSON à côté de client_api.py). Vide = pas de notifications app fermée.
FCM_SERVICE_ACCOUNT_FILE=

# ---------- Ancien mode LIVE Pi400 (plus utilisé, gardé pour compatibilité) ----------
# TELEGRAM_LIVE_REFRESH_SECONDS=2
# TELEGRAM_LIVE_SESSION_MINUTES=30
# TELEGRAM_LIVE_WARNING_MINUTES=5
# TELEGRAM_RING_OVERVIEW_REFRESH_SECONDS=2
# TELEGRAM_WEAR_FAILURE_THRESHOLD=2
# TELEGRAM_WEAR_FAILURE_WINDOW_SECONDS=180

# ---------- Anciens noms acceptés (inutiles si les noms ci-dessus sont remplis) ----------
# MQTT_PASS=          (= MQTT_PASSWORD)
# ADMIN_PASSWORD=     (= QRING_ADMIN_PASSWORD)
# SECRET_KEY=         (= QRING_SECRET_KEY)
# Au lancement seulement (pas dans le fichier) : QRING_ENV_FILE / DANY_ENV_FILE = chemin d'un autre .env
